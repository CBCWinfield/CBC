# Copy these into Render > your service > Environment. Never commit real values.

# Neon connection string (Neon dashboard > Connect). Starts with postgresql://
DATABASE_URL=

# The first librarian account is created from these on first start.
# Log in with them, then change the password on the My Library page.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# Email through Resend (resend.com > API Keys). EMAIL_FROM must use your verified domain,
# e.g. CBC Library <library@yourchurch.org>
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Optional phone/browser notifications. Generate with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:library@yourchurch.org

# Optional
LIBRARY_TIMEZONE=America/Chicago
# PUBLIC_URL=https://library.yourchurch.org   (Render fills in its own address automatically)
